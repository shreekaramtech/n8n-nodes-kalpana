{
	"name": "@kalpana-one/n8n-nodes-kalpana",
	"version": "0.1.0",
	"description": "n8n nodes for Kalpana: fill templates with data and render images and videos, in bulk or one at a time, and react when renders finish.",
	"license": "MIT",
	"homepage": "https://github.com/shreekaramtech/n8n-nodes-kalpana#readme",
	"keywords": [
		"n8n-community-node-package",
		"kalpana",
		"creative automation",
		"image generation",
		"templates",
		"bulk images",
		"video"
	],
	"author": {
		"name": "Shreekaram Technologies",
		"email": "support@kalpana.one"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/shreekaramtech/n8n-nodes-kalpana.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/KalpanaApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Kalpana/Kalpana.node.js",
			"dist/nodes/KalpanaTrigger/KalpanaTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.45.4",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"packageManager": "pnpm@12.4.1"
}
